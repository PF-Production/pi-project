[Unit]
Description=main.py MP3 dual-output player
After=network.target sound.target

[Service]
Type=simple
WorkingDirectory=/home/pi/pi-project
ExecStart=/usr/bin/python3 /home/pi/pi-project/main.py
Restart=on-failure
User=pi
Environment=PYTHONUNBUFFERED=1
# Optional: override defaults here or use CLI args / env vars in the unit file
# Environment=AUDIO_DEVICE_1=hw:2,0
# Environment=AUDIO_DEVICE_2=hw:3,0

[Install]
WantedBy=multi-user.target
