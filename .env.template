# Audio URLs for downloading WAV files
# 3 stereo files are used:
#   - sum.wav: 1.1 mix (L=Vox/mono, R=Sub) - used in 2ch mode
#   - instruments.wav: L-R Instruments/Surround (used in 4ch mode)
#   - vox_sub.wav: L=Vox (centre), R=Subs (used in 4ch mode)
WAV_SUM_URL=https://bit.ly/49QeYSd
WAV_INSTRUMENTS_URL=https://bit.ly/3NykXUd
WAV_VOX_SUB_URL=https://bit.ly/4jZ43u7

# Playback Mode: "2ch" or "4ch"
# 2ch: Plays sum.wav (L=Vox/mono, R=Sub) to a single stereo output
# 4ch: Plays vox_sub.wav (L=Vox, R=Sub) + instruments.wav (L=Surround L, R=Surround R)
PLAYBACK_MODE=4ch

# Audio Device Configuration
# Use stable device names (plughw:CARD=<name>) to avoid issues when card numbers change on reboot
# For Raspberry Pi with ALSA: use plughw:CARD=<name>,DEV=0 format (e.g., plughw:CARD=Headphones,DEV=0)
#   Run 'aplay -l' to see available card names
#   Legacy hw:X,Y format is also supported but may change on reboot
# For macOS with CoreAudio: leave empty to use default system audio
# For local development: leave empty to use pygame/system defaults
AUDIO_DEVICE_1=
AUDIO_DEVICE_2=

# Volume settings (0.0 to 1.0)
# VOX: Left channel (vox/mono) - used in both 2ch and 4ch modes
# SUB: Right channel (sub) - used in both 2ch and 4ch modes
# SURROUND_LEFT/RIGHT: Surround speakers - used in 4ch mode only
VOX_VOLUME=0.5
SUB_VOLUME=0.5
SURROUND_LEFT_VOLUME=0.5
SURROUND_RIGHT_VOLUME=0.5

# Playback schedule (24-hour HH:MM)
# Leave blank to start immediately on boot
PLAY_START_TIME=19:30
PLAY_END_TIME=22:30

# Remote Control Port
# Set to a port number (e.g. 3001) to enable remote control via TCP
# Set to 0 to disable
REMOTE_PORT=3001

# Loop Mask Track Settings
# A short audio track that plays near the end of each loop to mask the loop point
# LOOP_TRACK_URL: URL to download the loop mask audio file
# LOOP_VOLUME: Volume of the loop mask track (0.0 to 1.0)
# LOOP_LEAD_TIME: Seconds before loop end to start playing the mask track
LOOP_TRACK_URL=https://bit.ly/4r3wnOc
LOOP_VOLUME=0.5
LOOP_LEAD_TIME=24

# Parametric EQ Settings
# Each band has: frequency (Hz), gain (dB, -12 to +12), width (Q factor, 0.1 to 10)
# Format: EQ_<TRACK>_BAND<N>_FREQ=1000, EQ_<TRACK>_BAND<N>_GAIN=0, EQ_<TRACK>_BAND<N>_WIDTH=1.0

# Vox (left channel) EQ - used in both 2ch and 4ch modes (4 bands)
EQ_VOX_BAND1_FREQ=100
EQ_VOX_BAND1_GAIN=0
EQ_VOX_BAND1_WIDTH=1.0
EQ_VOX_BAND2_FREQ=500
EQ_VOX_BAND2_GAIN=0
EQ_VOX_BAND2_WIDTH=1.0
EQ_VOX_BAND3_FREQ=2000
EQ_VOX_BAND3_GAIN=0
EQ_VOX_BAND3_WIDTH=1.0
EQ_VOX_BAND4_FREQ=8000
EQ_VOX_BAND4_GAIN=0
EQ_VOX_BAND4_WIDTH=1.0

# Sub (right channel) EQ - used in both 2ch and 4ch modes (4 bands)
EQ_SUB_BAND1_FREQ=40
EQ_SUB_BAND1_GAIN=0
EQ_SUB_BAND1_WIDTH=1.0
EQ_SUB_BAND2_FREQ=80
EQ_SUB_BAND2_GAIN=0
EQ_SUB_BAND2_WIDTH=1.0
EQ_SUB_BAND3_FREQ=120
EQ_SUB_BAND3_GAIN=0
EQ_SUB_BAND3_WIDTH=1.0
EQ_SUB_BAND4_FREQ=200
EQ_SUB_BAND4_GAIN=0
EQ_SUB_BAND4_WIDTH=1.0

# Surround (instruments) EQ - used in 4ch mode only (4 bands)
EQ_SURROUND_BAND1_FREQ=100
EQ_SURROUND_BAND1_GAIN=0
EQ_SURROUND_BAND1_WIDTH=1.0
EQ_SURROUND_BAND2_FREQ=500
EQ_SURROUND_BAND2_GAIN=0
EQ_SURROUND_BAND2_WIDTH=1.0
EQ_SURROUND_BAND3_FREQ=2000
EQ_SURROUND_BAND3_GAIN=0
EQ_SURROUND_BAND3_WIDTH=1.0
EQ_SURROUND_BAND4_FREQ=8000
EQ_SURROUND_BAND4_GAIN=0
EQ_SURROUND_BAND4_WIDTH=1.0