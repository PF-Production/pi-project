# Audio URLs for downloading WAV/MP3 files
WAV_CENTRE_URL=https://www.dropbox.com/scl/fi/xrmgc1gnc2xwkre5e1avx/centre.wav?rlkey=alel16xkmxchzuz9pjlsj4kku&st=2xka0zyx&dl=1
WAV_STEREO_URL=https://www.dropbox.com/scl/fi/wqfhj5zt472x9ganchh0g/stereo.wav?rlkey=vo8m79g92pry9zj8zfii55q8m&st=2qcz6eu3&dl=1
MP3_CENTRE_URL=
MP3_STEREO_URL=

# Audio Device Configuration
# For Raspberry Pi with ALSA: use hw:X,Y format (e.g., hw:0,0, hw:1,0)
# For macOS with CoreAudio: leave empty to use default system audio
# For local development: leave empty to use pygame/system defaults
AUDIO_DEVICE_1=
AUDIO_DEVICE_2=

# Volume settings (0.0 to 1.0)
CENTRE_LEFT_VOLUME=0.5
CENTRE_RIGHT_VOLUME=0.5
STEREO_LEFT_VOLUME=0.5
STEREO_RIGHT_VOLUME=0.5

# Playback schedule (24-hour HH:MM)
# Leave blank to start immediately on boot
PLAY_START_TIME=19:30
PLAY_END_TIME=22:30

# Remote Control Port
# Set to a port number (e.g. 3001) to enable remote control via TCP
# Set to 0 to disable
REMOTE_PORT=3001

# Parametric EQ Settings
# Each band has: frequency (Hz), gain (dB, -12 to +12), width (Q factor, 0.1 to 10)
# Format: EQ_CENTRE_BAND1_FREQ=1000, EQ_CENTRE_BAND1_GAIN=0, EQ_CENTRE_BAND1_WIDTH=1.0
# Centre track EQ (4 bands)
EQ_CENTRE_BAND1_FREQ=100
EQ_CENTRE_BAND1_GAIN=0
EQ_CENTRE_BAND1_WIDTH=1.0
EQ_CENTRE_BAND2_FREQ=500
EQ_CENTRE_BAND2_GAIN=0
EQ_CENTRE_BAND2_WIDTH=1.0
EQ_CENTRE_BAND3_FREQ=2000
EQ_CENTRE_BAND3_GAIN=0
EQ_CENTRE_BAND3_WIDTH=1.0
EQ_CENTRE_BAND4_FREQ=8000
EQ_CENTRE_BAND4_GAIN=0
EQ_CENTRE_BAND4_WIDTH=1.0

# Stereo track EQ (4 bands)
EQ_STEREO_BAND1_FREQ=100
EQ_STEREO_BAND1_GAIN=0
EQ_STEREO_BAND1_WIDTH=1.0
EQ_STEREO_BAND2_FREQ=500
EQ_STEREO_BAND2_GAIN=0
EQ_STEREO_BAND2_WIDTH=1.0
EQ_STEREO_BAND3_FREQ=2000
EQ_STEREO_BAND3_GAIN=0
EQ_STEREO_BAND3_WIDTH=1.0
EQ_STEREO_BAND4_FREQ=8000
EQ_STEREO_BAND4_GAIN=0
EQ_STEREO_BAND4_WIDTH=1.0